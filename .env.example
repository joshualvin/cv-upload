# Copy to .env and fill in.

PORT=3000
# Public address candidates reach. The QR code points here.
PUBLIC_URL=https://cv.example.com
COMPANY_NAME=Acme Ltd
MAX_FILE_MB=10
RATE_LIMIT_PER_HOUR=10
# Set to true when running behind a reverse proxy / load balancer (nginx, Cloud Run, Render, ...)
TRUST_PROXY=false
# Job openings for the careers page when GOOGLE_SHEET_ID is not set (default: data/jobs.json)
JOBS_FILE=

# "google" = upload to Google Drive, "local" = save to ./uploads (for trying it out)
DRIVE_MODE=google
# The ID at the end of the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=
# true = file each CV into a subfolder named after the position
DRIVE_SUBFOLDER_PER_POSITION=false
LOCAL_UPLOAD_DIR=uploads

# --- Optional: AI review of each CV into a Google Sheet ---
# Anthropic API key from https://console.anthropic.com (leave empty to turn AI off)
ANTHROPIC_API_KEY=
# claude-opus-5-5 (most capable), claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
AI_MODEL=claude-opus-5-5
# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Dropdown options when there is no Positions tab in the sheet (comma-separated)
POSITIONS=
# Time zone for the "Submitted" column, e.g. Asia/Kuala_Lumpur
TIMEZONE=UTC

# --- Pick ONE way to sign in to Google ---

# Option A: OAuth with your own Google account (works with a normal personal Drive).
# Run `npm run get-token` once to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B: service account. The folder MUST be inside a Shared Drive
# (Google Workspace). Use a key file path OR paste the whole JSON on one line.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
