{
  "name": "cv-upload",
  "version": "1.0.0",
  "description": "Job seekers scan a QR code and upload their CV straight to Google Drive",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "DRIVE_MODE=local node --watch server.js",
    "test": "node --test test/*.test.js",
    "get-token": "node scripts/get-refresh-token.js",
    "format-phones": "node scripts/format-phones.js",
    "review-existing": "node scripts/review-existing.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/sheets": "^18.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4"
  }
}
